<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F4F7F5">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="かんたんボイスメモ" android:textSize="26sp" android:textStyle="bold" android:textColor="#18332B"/>
  <TextView android:id="@+id/summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/panel" android:textSize="18sp" android:textColor="#18332B"/>
  <Button android:id="@+id/speak" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="16dp" android:background="@drawable/record_button" android:text="🎙 話してメモする" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="今日のメモ" android:textSize="21sp" android:textStyle="bold" android:textColor="#18332B"/>
  <LinearLayout android:id="@+id/memoList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="毎日の通知時刻" android:textSize="21sp" android:textStyle="bold" android:textColor="#18332B"/>
  <LinearLayout android:id="@+id/timeList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
  <Button android:id="@+id/addTime" android:layout_width="match_parent" android:layout_height="56dp" android:text="＋ 通知時刻を追加" android:textSize="18sp"/>
 </LinearLayout>
</ScrollView>
